# Agent is a first-class Tree workspace. Its request is executed against the
# demo local library; the same Controller path also supplies saved Streams.
size 110x30
load
keys j j j j
expect-state browsed=agent node=agent rows=0
key Enter
expect Agent >
type 播放夜曲
key Enter
expect-state browsed=agent rows=1 pane=tracks
expect Source / Title
expect [Local]
