#!/usr/bin/make -f
# Standard CMake build. No MPD service is installed or enabled: termusic is a
# client and the daemon lifecycle is not its business.
%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF

override_dh_auto_install:
	DESTDIR=$(CURDIR)/debian/termusic cmake --install obj-x86_64-linux-gnu
